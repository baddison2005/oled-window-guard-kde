#!/bin/sh
set -eu

APP_ROOT=/usr/libexec/oled-window-guard
PYTHONPATH="$APP_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

# Do not claim support on a compositor older than the packaged target.
if command -v kwin_wayland >/dev/null 2>&1; then
    version=$(kwin_wayland --version 2>/dev/null | sed -n 's/.*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)
    if [ -n "$version" ] && [ "$(printf '%s\n' 6.7.5 "$version" | sort -V | head -n 1)" != 6.7.5 ]; then
        echo "OLED Window Guard requires KWin 6.7.5 or newer (found $version)" >&2
        exit 2
    fi
fi

exec /usr/bin/python3 -m oled_window_guard "$@"
